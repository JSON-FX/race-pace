# Local Edge Function secrets (gitignored real values live in .env)
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key

# Webhook signing secret from the PayMongo webhook resource (hosted); a test-only value locally.
PAYMONGO_WEBHOOK_SECRET=whsec_your_paymongo_webhook_secret

# Where an organization admin redeems an invite: the ADMIN console (apps/web),
# never the runner storefront. org-provision and org-members build their manual
# sign-in link as <ADMIN_APP_URL>/auth/confirm?token_hash=... and pass the same
# URL as `redirectTo` on the invite email.
#
# WITHOUT IT: buildInviteLink returns null, so a provisioned organization comes
# back with `invite_link: null` and the console shows "a sign-in link could not
# be generated" — there is then no way to hand the organization over, because
# SMTP is not configured on this project either. Supabase falls back to
# config.toml's `site_url` for the emailed path, and that is the runner
# storefront, which has no /auth/confirm route at all.
ADMIN_APP_URL=http://localhost:3001

# Local ticket-email capture. Resend remains the default when unset.
# EMAIL_PROVIDER=mailtrap
# MAILTRAP_SMTP_USER=
# MAILTRAP_SMTP_PASSWORD=
# EMAIL_FROM=Race Pace QA <qa@racepace.test>

# Local capture, no external SMTP quota. Uses the bundled Supabase Mailpit container.
# EMAIL_PROVIDER=mailpit
# MAILPIT_SMTP_HOST=inbucket

# Organizer inquiry verification. The public reCAPTCHA site key is repeated
# here so the assessment can bind the browser token to the expected key.
GOOGLE_CLOUD_PROJECT_ID=race-pace-project-id
RECAPTCHA_ENTERPRISE_API_KEY=replace-with-server-api-key
RECAPTCHA_ENTERPRISE_SITE_KEY=replace-with-enterprise-site-key
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,www.racepace.com.ph
RECAPTCHA_MIN_SCORE=0.7
INQUIRY_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
