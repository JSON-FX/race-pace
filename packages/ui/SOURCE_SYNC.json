  "adaptations": [
    "Replace cn imports with the existing clsx/tailwind-merge helper",
    "Mark existing DOM/portal roots with data-rp-ui for component-only RGB tokens",
    "Wrap direct color token references for the application RGB contract",
    "Add client boundaries for hook-based modules",
    "Retain current app Sonner theme observation and table divider compatibility",
    "Button loading and disabled-link compatibility; semantic destructive foreground in dark mode",
    "Card asChild extension preserves linked card DOM and geometry",
    "Overlay opener restoration supports programmatic table and upload workflows",
    "Progress measured value propagation and Slider thumb accessible labels",
    "CommandDialog accessible header belongs inside the modal",
    "SidebarInset min-width and hidden scanner-input geometry preserve the application shell",
    "Source roots exclude SidebarProvider and SidebarInset to preserve page canvases",
    "Outline Button declares foreground for contrast inside dark section compositions",
    "Calendar Tailwind variable syntax and compact 36px cells fit a 320px viewport",
    "DatePicker uses Fieldnotes Calendar/Popover with civil-date form values and styled month/year menus",
    "FormSelect retains native server rendering, FormData, reset and validation with a Radix menu after hydration",
    "ChoiceGroup plain variant and optional status dots support annotated application contexts"
  ],
